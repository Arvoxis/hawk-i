# Hawk-I configuration — copy to .env and fill in.
#   cp .env.example .env
#
# Everything here is read once by backend/config.py.  Values shown are the
# defaults that apply when a key is absent, so you only need to set what
# differs for your setup.  Run `python backend/config.py` to print the
# resolved configuration and confirm the file was picked up.

# ── Network / hosts ───────────────────────────────────────────
# GCS_HOST     : IP of the laptop/PC running the FastAPI backend.
#                The Jetson connects here, and the dashboard calls it.
#                Use "localhost" when everything runs on one machine.
# JETSON_HOST  : IP of the Jetson on the same network (diagnostics only)
# RECEIVER_PORT: port for scripts/standalone_receiver.py (must differ from GCS_PORT)
GCS_HOST=localhost
GCS_PORT=8000
JETSON_HOST=<jetson_ip>
RECEIVER_PORT=8001

# ── Jetson hardware ───────────────────────────────────────────
MAVLINK_SERIAL=/dev/ttyTHS1

# ── PostgreSQL + PostGIS ──────────────────────────────────────
# Matches docker-compose.yml. Change the password in both places together.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hawki_db
DB_USER=hawki_user
DB_PASSWORD=hawki

# ── Ollama / LLM ──────────────────────────────────────────────
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
LLM_MODEL=gemma3:4b
LLM_TIMEOUT_S=30
# Seconds between batch-report sweeps
LLM_BATCH_INTERVAL=30
# Minimum detector confidence for a detection to earn an LLM report
LLM_CONF_THRESHOLD=0.60

# GPU layers for Ollama. Leave unset to let Ollama decide.
# Set to 0 to force CPU inference — needed when the host NVIDIA driver is
# older than the CUDA kernels Ollama ships, which fails with
# "CUDA error: device kernel image is invalid".  Check with: nvidia-smi
# OLLAMA_NUM_GPU=0

# Circuit breaker: after this many consecutive LLM failures, reports fall back
# to the rule-based generator for the cooldown period instead of paying the
# full timeout on every detection.
# LLM_BREAKER_THRESHOLD=3
# LLM_BREAKER_COOLDOWN_S=120

# ── Model weights ─────────────────────────────────────────────
# Default: <repo>/models/. Override the directory or individual checkpoints.
# HAWKI_MODELS_DIR=/path/to/models
# HAWKI_YOLO_WEIGHTS=/path/to/hawki_yolo11n.pt
# HAWKI_SAM2_CHECKPOINT=/path/to/sam2.1_hiera_small.pt

# ── Camera intrinsics (drive the GSD → cm² conversion) ────────
# These determine every reported defect area, so set them to your actual
# camera.  Defaults match the Raspberry Pi HQ cam (IMX477).
#   GSD_cm_per_px = (altitude_m × sensor_width_mm) / (focal_mm × width_px) × 100
#   area_cm²      = mask_pixel_count × GSD²
CAMERA_SENSOR_WIDTH_MM=6.287
CAMERA_FOCAL_MM=4.74
CAMERA_IMAGE_WIDTH_PX=1920

# Altitudes below MIN_ALT_M are treated as a bad GPS fix and replaced by
# DEFAULT_ALT_M, so a dropped fix degrades the area estimate instead of
# zeroing it.
MIN_ALT_M=2.0
DEFAULT_ALT_M=10.0

# ── Severity thresholds (cm², IRC-calibrated) ─────────────────
# L1 < SEVERITY_L2_CM2 ≤ L2 < SEVERITY_L3_CM2 ≤ L3
SEVERITY_L2_CM2=100
SEVERITY_L3_CM2=500

# ── Detection + model gates ───────────────────────────────────
# Minimum detector confidence to enter the processing queue at all
MIN_DETECTION_CONF=0.45
# SAM 2 predicted-IoU below which the bbox area is used instead of the mask
SAM_MASK_QUALITY_THRESHOLD=0.75
# DINOv2 cosine similarity below which a detection is flagged for review
DINOV2_LOW_SIMILARITY_THRESHOLD=0.45

# ── Ground-station YOLO (optional) ────────────────────────────
# The Jetson already runs the detector. Enable this only for a camera-only
# payload that streams raw frames without on-board inference.
GS_YOLO_ENABLED=0

# ── GCS display / capture (optional) ──────────────────────────
# GCS_HEADLESS=1          # 0 opens a live OpenCV window on the GCS
# GCS_SAVE_DIR=captures
# GCS_AUTO_SAVE=0
# GCS_AUTO_SAVE_CONF=0.70
# GCS_LOG_FILE=detections.jsonl
