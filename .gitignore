# ── Virtual environments ──────────────────────────────────────
hawki_env/
venv/
.venv/

# ── Python cache ──────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# ── Secrets — real IPs/passwords never committed ──────────────
.env
# .env.example is intentionally committed (placeholders only)

# ── Model weights ─────────────────────────────────────────────
# Large checkpoints are downloaded, not committed.  The 5 MB fine-tuned
# YOLOv11n detector is the one exception — it is the project's core artefact.
models/*
!models/hawki_yolo11n.pt

# ── Database ──────────────────────────────────────────────────
*.db
*.sqlite

# ── Runtime data / logs ───────────────────────────────────────
detections.jsonl
backend/detections.jsonl
captures/
data/frames/
data/live_frame.jpg

# ── Generated reports ─────────────────────────────────────────
reports/
data/reports/
*.pdf
!docs/**/*.pdf

# ── IDE ───────────────────────────────────────────────────────
.vscode/
.idea/

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Microsoft Office temp files ───────────────────────────────
~$*.docx
~$*.xlsx
~$*.pptx

# ── Claude Code internals ─────────────────────────────────────
.claude/
